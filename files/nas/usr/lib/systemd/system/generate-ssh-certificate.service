[Unit]
Description=Generate ssh host certificate for authentication
After=network-online.target remote-fs.target local-fs.target
After=nas-monitor.service
# No RequiresMountsFor: that would mount the NAS on every boot. The script
# goes through var-mnt-nas.automount only when a renewal is due.
After=var-mnt-nas.automount
#AssertPathIsMountPoint=/var/mnt/nas 
Before=umount.target
[Service]
Type=oneshot
ExecStart=/usr/bin/generate-ssh-certificate.sh
TimeoutStartSec=1h 15min
TimeoutStopSec=10
Restart=on-failure
RestartSec=10min
RemainAfterExit=no
[Install]
WantedBy=default.target
